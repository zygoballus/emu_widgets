.imu-page
{
	background-color: #000000;
	color: #ffffff;
	height: 99.8%;

	/* Chrome 10, Safari (Webkit) */
	background-image: -webkit-gradient(linear, left top, right top, color-stop(0, #000000), color-stop(1, #646464));

	/* Chrome 11+ */ 
	background-image: -webkit-linear-gradient(left, #000000 0%, #646464 100%);

	/* IE 7 */
	filter: progid:DXImageTransform.Microsoft.gradient(startColorStr='#000000', endColorStr='#646464', GradientType=1);

	/* IE 8 */
	-ms-filter: "progid:DXImageTransform.Microsoft.gradient(startColorstr=#000000, endColorstr=#646464, GradientType=1)";

	/* IE 10 Consumer Preview */ 
	background-image: -ms-linear-gradient(left, #000000 0%, #646464 100%);

	/* Firefox */ 
	background-image: -moz-linear-gradient(center left, #000000, #646464);

	/* Opera */ 
	background-image: -o-linear-gradient(left, #000000 0%, #646464 100%);

	/* W3C Markup, IE 10 Release Preview */ 
/*
	background-image: linear-gradient(to right, #000000 0%, #646464 100%);
*/
}

body.imu-page
{
	margin-bottom: 0;
	margin-left: 0;
	margin-right: 0;
	margin-top: 0;
	position: absolute;
}

/* sidebar
*/
.imu-page > .holder > .sidebar
{
	width: 25.0em;
}

.imu-page > .holder > .sidebar .searches-label
{
	color: #000000;
	font-weight: bold;
	padding: 0.3em;
}

.imu-page > .holder > .sidebar .collections-label
{
	color: #000000;
	font-weight: bold;
	padding: 0.3em;
}

.imu-page > .holder > .sidebar .collections
{
	height: 400px;
}

/* content
*/
.imu-page > .holder > .content
{
	color: #ffffff;
}
